# Python
__pycache__/
*.py[cod]

# Generated analysis outputs
results/

# Raw scan tiles (large; kept locally, archived per run to results/figures/vk4_source.zip)
vk4/

# pflm_ui.py local state (sample library + staged cell_params for a run)
.ui_samples.json
.ui_samples.json.bak
.ui_workspace/

# Per-sample inputs (fabrication DXF + laser-param CSVs) are kept locally and managed via the
# pflm_ui sample library (.ui_samples.json), not committed.
dxf/
csv/

# Fabrication mask layouts are unpublished lab geometry: their filenames alone disclose the
# pin diameter/pitch design matrix and the lattice pivot.  Never commit a DXF anywhere in the
# tree, including tests/fixtures/.  selftest.py resolves them locally (PFLM_DXF_DIR env var,
# then the OneDrive data tree, then the working-tree fixture dirs), so untracked copies on
# disk still satisfy every check.
*.dxf

# Generated by porosity_table.py
porosity_square_vs_hex.png
